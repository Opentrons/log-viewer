{
  "name": "@log-viewer/app-shell",
  "version": "0.0.1",
  "description": "Log viewer electron shell application",
  "main": "lib/main.js",
  "types": "lib/main.d.ts",
  "dependencies": {
    "@log-viewer/app": "workspace:*",
    "dateformat": "5.0.3",
    "electron": "43.3.0",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "fs-extra": "11.4.0",
    "lodash": "4.18.1",
    "merge-options": "3.0.4",
    "uuid": "14.0.1",
    "winston": "3.19.0",
    "yargs-parser": "22.0.0"
  },
  "devDependencies": {
    "@types/dateformat": "^5.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.25",
    "@types/yargs-parser": "^21.0.3",
    "conf": "15.1.0",
    "electron-builder": "26.15.6",
    "vite": "8.2.0",
    "winston-transport": "4.9.0"
  },
  "build": {
    "appId": "com.opentrons.log-viewer",
    "electronVersion": "43.3.0",
    "files": [
      {
        "from": "../app/dist",
        "to": "./lib/ui",
        "filter": [
          "**/*"
        ]
      },
      "./lib/shell/**/*"
    ],
    "artifactName": "${productName}-v${version}-${os}-${env.BUILD_ID}.${ext}",
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "forceCodeSigning": true,
      "gateKeeperAssess": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "forceCodeSigning": true,
      "signTooloptions": {
        "publisherName": [
          "Opentrons Labworks Inc.",
          "OPENTRONS LABWORKS INC."
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "log-viewer",
      "category": "Science"
    },
    "generateUpdateFilesForALlChannels": true
  }
}
